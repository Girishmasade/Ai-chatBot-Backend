# ==========================================
# Server Environment Variables Template
# ==========================================

NODE_ENV=production
PORT=5500
FRONTEND_URL=http://localhost:3000

# Database & Cache
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ai-chatbot?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# Authentication & JWT
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_here
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
SESSION_SECRET=your_session_secret_here
ENCRYPTION_SECRET=your_32_character_encryption_secret_here

# Payment Gateway (Razorpay)
RAZORPAY_API_KEY=rzp_test_xxxxxx
RAZORPAY_API_SECRET_KEY=xxxxxx

# Cloudinary Media Storage
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Email / SMTP
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Vector Database (Pinecone)
PINECONE_INDEX_NAME=chatbot-index
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_REGION=us-east-1

# External AI Providers
HUGGINGFACE_API_KEY=hf_xxxxxx

# OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_FALLBACK_URL=http://localhost:5500/api/v1/auth/google/callback
GITHUB_APP_ID=
GITHUB_SECRET=
GITHUB_FALLBACK_URL=http://localhost:5500/api/v1/auth/github/callback
FACEBOOK_APP_ID=
FACEBOOK_SECRET=
FACEBOOK_FALLBACK_URL=http://localhost:5500/api/v1/auth/facebook/callback
